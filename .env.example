# ============================================
# AI20K Project - Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ---- Runtime ----
# Local dev currently uses Python 3.13.x. Railway can use this value when set.
PYTHON_VERSION=3.13

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
MODEL_NAME=gpt-4o-mini
# Optional providers if you add them later:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Embedding Configuration ----
EMBEDDING_MODEL_NAME=text-embedding-3-small
QUERY_EMBEDDING_MAX_CHARS=6000

# ---- Database ----
# Local Docker Compose default. For Railway, replace with the Railway Postgres URL
# and use the async SQLAlchemy driver prefix: postgresql+asyncpg://...
DATABASE_URL=postgresql+asyncpg://legalai_user:changeme@localhost:5433/legalai_db
POSTGRES_PASSWORD=changeme

# ---- Vector Store ----
# Vector embeddings are stored in PostgreSQL via pgvector.

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
# Local dev origins. Production should include the Vercel app URL, for example:
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_UPLOAD_FILE_SIZE_MB=128
MAX_CONCURRENT_UPLOADS=2

# ---- JWT Security ----
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- Public Chat Rate Limit ----
# Applies only to unauthenticated chat requests. Keep values forgiving for driver lookup.
PUBLIC_CHAT_RATE_LIMIT_ENABLED=true
PUBLIC_CHAT_RATE_LIMIT_BURST_REQUESTS=6
PUBLIC_CHAT_RATE_LIMIT_BURST_WINDOW_SECONDS=60
PUBLIC_CHAT_RATE_LIMIT_SUSTAINED_REQUESTS=30
PUBLIC_CHAT_RATE_LIMIT_SUSTAINED_WINDOW_SECONDS=600
DOCUMENT_LIFECYCLE_SYNC_ENABLED=true
DOCUMENT_LIFECYCLE_SYNC_INTERVAL_SECONDS=3600
RETRIEVAL_FTS_MAX_TERMS=48

# ---- LangSmith Monitoring ----
# Set LANGCHAIN_TRACING_V2=false unless LANGCHAIN_API_KEY is a real key.
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# Optional Langfuse tracing. Disabled until both keys are configured.
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_SAMPLE_RATE=1.0
QUALITY_MIN_PRODUCTION_SAMPLE=20

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Object Storage (supported; disabled until bucket credentials are configured) ----
OBJECT_STORAGE_ENABLED=false
OBJECT_STORAGE_PROVIDER=s3
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_PRESIGNED_URL_EXPIRE_SECONDS=300
KB_REQUIRE_OBJECT_STORAGE=false
KB_LOCAL_STORAGE_PATH=app/backend/storage/kb_v2


# ---- Frontend / Vercel ----
# Vercel should set this to the Railway backend domain.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- E2E / Playwright ----
# Used by admin E2E tests. Never commit real credentials.
E2E_ADMIN_EMAIL=admin@example.test
E2E_ADMIN_PASSWORD=replace-with-admin-password
PLAYWRIGHT_FRONTEND_URL=http://127.0.0.1:3017
